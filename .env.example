# Copy to .env and fill in. .env is gitignored — a user_session value is a
# live credential that grants full access to the account.
#
# Obtain it by signing in at https://account.nicovideo.jp/login?site=niconico
# in a browser and copying the `user_session` cookie for .nicovideo.jp.
NICONICO_SESSION=

# Set to 1 to enable the live test suite (`npm test` skips it otherwise).
NICONICO_LIVE=
